{
  "manifest_version": 3,
  "name": "Unscroll — Kısa Video & Yorum Kalkanı",
  "version": "3.8.0",
  "description": "Un + Scroll: Kaydırmayı bırak, sonsuz kaydırma döngüsünden çık. YouTube Shorts, Instagram Reels, TikTok ve toksik yorumları engeller.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.vsolken.com/*",
    "*://*.eminipek.dev/*",
    "*://*.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ScrollBlock Kontrol Paneli",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["detectors/youtube/youtube-detector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["detectors/instagram/instagram-detector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["detectors/tiktok/tiktok-detector.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.vsolken.com/*",
        "*://*.eminipek.dev/*",
        "*://*.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["detectors/bridge/vsolken-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
