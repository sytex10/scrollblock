{
  "manifest_version": 3,
  "name": "ShortBan — Kısa Video & Yorum Kalkanı",
  "version": "4.4.0",
  "description": "Short + Ban: YouTube Shorts, Instagram Reels, TikTok kısa video akışlarını ve toksik yorumları engeller (YouTube Music'e dokunmaz).",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.vsolken.com/*",
    "*://*.eminipek.dev/*",
    "*://*.netlify.app/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ShortBan Kontrol Paneli",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": [
        "*://music.youtube.com/*",
        "*://studio.youtube.com/*",
        "*://kids.youtube.com/*",
        "*://tv.youtube.com/*"
      ],
      "js": ["detectors/youtube/youtube-detector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["detectors/instagram/instagram-detector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["detectors/tiktok/tiktok-detector.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.vsolken.com/*",
        "*://*.eminipek.dev/*",
        "*://*.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["detectors/bridge/vsolken-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
